{
  "name": "own-rich-calendar",
  "version": "1.0.0",
  "description": "Your own rich calendar",
  "author": "Muhammad Bappi <abappi2019@gmail.com>",
  "license": "MIT",
  "repository": "https://github.com/abappi19/own-rich-calendar",
  "main": "dist/index.js",
  "module": "dist/index.module.js",
  "source": "src/index.ts",
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "build": "microbundle-crl build",
    "start": "microbundle-crl watch --no-compress --format modern,cjs",
    "test": "run-s test:unit test:lint test:build",
    "test:lint": "eslint .",
    "test:unit": "cross-env CI=1 react-scripts test --env=jsdom",
    "test:watch": "react-scripts test --env=jsdom",
    "predeploy": "cd example && yarn install && yarn run build",
    "deploy": "gh-pages -d example/build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/jest": "^25.1.4",
    "@types/node": "^12.12.38",
    "@types/react": "^16.9.27",
    "@types/react-dom": "^16.9.7",
    "cross-env": "^7.0.2",
    "microbundle": "^0.15.1",
    "microbundle-crl": "^0.13.11",
    "typescript": "^3.7.5",
    "webpack": "^5.99.5",
    "webpack-cli": "^6.0.1"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "date-fns": "^4.1.0"
  }
}
